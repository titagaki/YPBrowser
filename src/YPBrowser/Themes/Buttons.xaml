<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ボタンの共通テーマ。
        WPF 既定 (Aero2) のグラデーションをやめ、角丸フラット + ホバー/押下のオーバーレイにする。

        オーバーレイ方式にしている理由:
        Background を状態ごとに差し替えると、Background を自前で指定しているボタン
        (ColorPickerDialog の色見本など) が状態変化で色を失う。半透明の板を重ねるだけなら
        どんな Background でも同じ見た目の変化になる。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate x:Key="FlatButtonTemplate" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Squish" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Border x:Name="Bg" CornerRadius="5"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="HoverLayer" CornerRadius="5" Opacity="0"
                    Background="{StaticResource Btn.HoverOverlay}" />
            <Border x:Name="PressLayer" CornerRadius="5" Opacity="0"
                    Background="{StaticResource Btn.PressOverlay}" />
            <!-- キーボードフォーカス時のリング。マウス操作では出さない -->
            <Border x:Name="FocusRing" CornerRadius="5" Opacity="0"
                    BorderThickness="2" BorderBrush="{StaticResource Btn.Accent}" />

            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.16" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="Squish"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="0.97" Duration="0:0:0.05" />
                            <DoubleAnimation Storyboard.TargetName="Squish"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="0.97" Duration="0:0:0.05" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Squish"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Squish"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 既定。白地 + 細い枠 -->
    <Style x:Key="FlatButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}" />
        <Setter Property="Background" Value="{StaticResource Btn.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Btn.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <!-- ダイアログの既定ボタン (OK) は自動でアクセント色にする -->
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{StaticResource Btn.Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 明示的にアクセント色にしたいとき -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="{StaticResource Btn.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 枠なし。一覧の中など、常時ボタンに見せたくない場所用 -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#FF3A4048" />
    </Style>

    <!-- 設定カードの右端に置く「⋯」。押すまではボタンに見せない -->
    <Style x:Key="CardMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.ForegroundMuted}" />
    </Style>

    <!-- 停止など、戻せない操作用 -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Btn.DangerBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Btn.Danger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- 全ボタンに適用 -->
    <Style TargetType="Button" BasedOn="{StaticResource FlatButtonStyle}" />

    <!-- ToolBar 内は ToolBar 側のスタイルが優先されるので、そちらにも差しておく -->
    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button"
           BasedOn="{StaticResource FlatButtonStyle}" />

</ResourceDictionary>
