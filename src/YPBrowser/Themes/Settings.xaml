<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:YPBrowser.Views.Controls">

    <!--
        設定画面の見た目。

        方針:
        1 設定 = 1 カード行。行の中身は SettingCard が決め、ページ側は
        「どのカードを並べるか」だけを書く。ページごとに Grid を組み直すと
        間隔と右端の位置がページ間でずれるため。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="Set.CardBackground" Color="#FFFBFBFB" />
    <SolidColorBrush x:Key="Set.CardBorder" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="Set.NavSelected" Color="#FFEFF6FC" />
    <SolidColorBrush x:Key="Set.NavSelectedForeground" Color="#FF003E73" />
    <SolidColorBrush x:Key="Set.BadgeBackground" Color="#FFEFF6FC" />
    <SolidColorBrush x:Key="Set.BadgeForeground" Color="#FF003E73" />

    <!-- Windows 11 のアイコン。無い環境では MDL2 へ落ちる -->
    <FontFamily x:Key="Set.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================ SettingCard ============================ -->

    <Style TargetType="{x:Type ctl:SettingCard}">
        <Setter Property="Background" Value="{StaticResource Set.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Set.CardBorder}" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SettingCard}">
                    <Border x:Name="Bd" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <!-- 子行の字下げ (42px) は、この欄 + 左パディングで作る -->
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Icon" Grid.Column="0"
                                       Text="{TemplateBinding Icon}"
                                       FontFamily="{StaticResource Set.IconFont}" FontSize="15"
                                       Foreground="{StaticResource Ctl.ForegroundMuted}"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="LeadingLabel" Width="46" CornerRadius="3"
                                            Margin="0,0,10,0" Padding="0,1" VerticalAlignment="Center"
                                            Background="{StaticResource Ctl.Background}"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource Set.CardBorder}">
                                        <TextBlock Text="{TemplateBinding LeadingLabel}" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Ctl.ForegroundMuted}" />
                                    </Border>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border x:Name="Badge" CornerRadius="3" Margin="6,0,0,0"
                                            Padding="5,0" VerticalAlignment="Center"
                                            Background="{StaticResource Set.BadgeBackground}">
                                        <TextBlock Text="{TemplateBinding Badge}" FontSize="10"
                                                   Foreground="{StaticResource Set.BadgeForeground}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="Description" Margin="0,2,0,0"
                                           Text="{TemplateBinding Description}" FontSize="11"
                                           Foreground="{StaticResource Ctl.ForegroundMuted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ContentPresenter Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDescriptionMonospace" Value="True">
                            <Setter TargetName="Description" Property="FontFamily" Value="Consolas, Cascadia Mono" />
                        </Trigger>

                        <Trigger Property="Badge" Value="">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="LeadingLabel" Value="">
                            <Setter TargetName="LeadingLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="LeadingLabel" Value="{x:Null}">
                            <Setter TargetName="LeadingLabel" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- 枠を描くのは外側の Border。ここは中身の並びだけ担当する -->
                        <Trigger Property="Variant" Value="GroupHeader">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Trigger>

                        <Trigger Property="Variant" Value="SubRow">
                            <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,1,0,0" />
                            <Setter TargetName="Bd" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="12,9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 見出しカード + 子行を1枚の枠に収める入れ物 -->
    <Style x:Key="SettingGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Set.CardBackground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Set.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================ ページの文字 ============================ -->

    <Style x:Key="SettingPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 関連する設定をまとめる小さな灰色の見出し -->
    <Style x:Key="SettingGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ctl.ForegroundMuted}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <!-- 編集モーダルの中の項目名。カード行と違い、入力欄の上に置く -->
    <Style x:Key="SettingFieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ctl.ForegroundMuted}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- 置換子の一覧。押すと引数へ差し込まれるので、行全体をボタンにする -->
    <Style x:Key="SettingTokenRowStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource Set.NavSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- カードの外に置く補足 -->
    <Style x:Key="SettingHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ctl.ForegroundMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="2,2,0,0" />
    </Style>

    <!-- ============================ 左ナビ ============================ -->

    <Style x:Key="SettingsNavIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Set.IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="24" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- 色を指定すると選択時に文字色が変わらなくなるので、濃さは不透明度で落とす -->
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- 選択は角丸の塗り。行いっぱいの反転バーにはしない -->
                    <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctl.HoverTint}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Set.NavSelected}" />
                            <Setter Property="Foreground" Value="{StaticResource Set.NavSelectedForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsNavListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsNavItemStyle}" />
    </Style>

    <!-- ============================ トグルスイッチ ============================ -->

    <!--
        チェックボックスは「後で OK を押して確定する」形を連想させる。
        設定画面は即時反映なので、その場で切り替わったことが分かる形にする。
    -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="#FFF2F3F4" BorderBrush="#FF8A8F98" />
                            <Ellipse x:Name="Knob" Width="11" Height="11"
                                     HorizontalAlignment="Left" Margin="5,0,0,0"
                                     Fill="{StaticResource Ctl.ForegroundMuted}" />
                            <Border x:Name="FocusRing" CornerRadius="12" BorderThickness="2" Opacity="0"
                                    Margin="-3" BorderBrush="{StaticResource Btn.Accent}" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Btn.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0" />
                        </Trigger>
                        <!-- ラベル無しで使うとき（カードが見出しを持つ場合）に余白を残さない -->
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
