<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ボタン以外の共通スタイル。

        選択色について:
        チャンネル一覧の行はタグの色で塗られるため、選択やホバーで背景を「差し替える」と
        タグの色が消える。ここでも半透明の板を重ねる方式にして、下の色を残す。
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ============================ TextBox ============================ -->

    <Style x:Key="FlatTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Ctl.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ctl.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="CaretBrush" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Btn.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <!-- フォーカス時の下線。枠の太さを変えないので文字がずれない -->
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom"
                                CornerRadius="0,0,4,4" Opacity="0"
                                Background="{StaticResource Btn.Accent}" />
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ctl.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ctl.BorderHover}" />
                            <Setter TargetName="FocusLine" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctl.DisabledBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource Ctl.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource FlatTextBoxStyle}" />

    <!-- ============================ CheckBox ============================ -->

    <Style x:Key="FlatCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box" CornerRadius="3" BorderThickness="1"
                                    Background="{StaticResource Ctl.Background}"
                                    BorderBrush="#FF8A8F98" />
                            <Path x:Name="Check" Opacity="0" Stroke="White" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" />
                            <Rectangle x:Name="Dash" Opacity="0" Width="8" Height="2" RadiusX="1" RadiusY="1"
                                       Fill="White" />
                            <Border x:Name="FocusRing" CornerRadius="4" BorderThickness="2" Opacity="0"
                                    Margin="-3" BorderBrush="{StaticResource Btn.Accent}" />
                        </Grid>
                        <ContentPresenter Margin="7,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Btn.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Btn.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                            <Setter TargetName="Dash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Btn.AccentBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource FlatCheckBoxStyle}" />

    <!-- ============================ ComboBox ============================ -->

    <!-- 開閉のトグル。枠は本体側が描くので、ここは透明 + 山形だけ -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
        <Grid Background="Transparent">
            <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,8,0" Data="M 0,0 L 4,4 L 8,0"
                  Stroke="{StaticResource Ctl.ForegroundMuted}" StrokeThickness="1.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Ctl.Foreground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="FlatComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="4" Margin="3,1" Background="Transparent">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF0F2F5" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE4EEF8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ctl.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FlatComboBoxItemStyle}" />

    <Style x:Key="FlatComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Ctl.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Ctl.Border}" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="22" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Bd" Grid.ColumnSpan="2" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" />

                        <!-- 編集可のときは左半分をテキストボックスが覆うので、
                             クリックで開くのは山形の部分だけになる -->
                        <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press"
                                      Template="{StaticResource ComboToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- DisplayMemberPath を効かせるには ContentTemplateSelector まで含めて
                             標準テンプレートと同じ組み合わせを渡す必要がある -->
                        <ContentPresenter x:Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left" />

                        <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Visibility="Collapsed"
                                 Margin="{TemplateBinding Padding}" Padding="0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 SelectionBrush="{StaticResource Btn.Accent}">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,3,10,10" CornerRadius="6" BorderThickness="1"
                                    Background="{StaticResource Ctl.PopupBackground}"
                                    BorderBrush="{StaticResource Ctl.Border}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                      Direction="270" Opacity="0.18" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer Margin="0,3">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ctl.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Btn.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctl.DisabledBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource Ctl.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource FlatComboBoxStyle}" />

    <!-- ============================ ListBox ============================ -->

    <Style x:Key="FlatListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="HoverTint" Opacity="0"
                                    Background="{StaticResource Ctl.HoverTint}" />
                            <Border x:Name="SelectTint" Opacity="0"
                                    Background="{StaticResource Ctl.SelectTint}" />
                            <!-- 選択行の左に出る帯。背景が塗られている行でも位置が分かる -->
                            <Border x:Name="SelectBar" Width="3" HorizontalAlignment="Left" Opacity="0"
                                    Background="{StaticResource Btn.Accent}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectTint" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectBar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Ctl.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FlatListBoxItemStyle}" />

    <Style x:Key="FlatListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Ctl.Background}" />
        <Setter Property="BorderBrush" Value="#FFE5E5E5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource FlatListBoxStyle}" />

    <!-- ============================ TabControl ============================ -->

    <Style x:Key="FlatTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Ctl.ForegroundMuted}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverTint" Opacity="0" CornerRadius="4" Margin="2,2,2,0"
                                Background="{StaticResource Ctl.HoverTint}" />
                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                        <!-- 選択中はアクセント色の下線。枠で囲む昔ながらのタブにはしない -->
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Opacity="0"
                                Margin="8,0" CornerRadius="1"
                                Background="{StaticResource Btn.Accent}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Ctl.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Btn.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource FlatTabItemStyle}" />

    <Style x:Key="FlatTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{StaticResource Ctl.Background}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="White"
                                BorderThickness="0,0,0,1" BorderBrush="#FFE5E5E5">
                            <TabPanel IsItemsHost="True" Margin="4,0,0,0" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource FlatTabControlStyle}" />

    <!-- ============================ Slider ============================ -->

    <!-- つまみより左（値の側）を塗るバー -->
    <Style x:Key="SliderFillStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{StaticResource Btn.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource Ctl.Border}"
                                 StrokeThickness="1" />
                        <Ellipse x:Name="Dot" Width="8" Height="8"
                                 Fill="{StaticResource Btn.Accent}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="10" />
                            <Setter TargetName="Dot" Property="Height" Value="10" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="7" />
                            <Setter TargetName="Dot" Property="Height" Value="7" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Ctl.BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 横向き専用。このアプリのスライダー（色の選択の RGB）は全て横向き。
         縦向きで使うときはテンプレートを足すこと -->
    <Style x:Key="FlatSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- 目盛りを刻まず、クリックした位置へ直接飛ばす（色選びは微調整より直感が優先） -->
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border x:Name="Rail" Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="#FFE3E5E8" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFillStyle}"
                                              Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackStyle}"
                                              Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource FlatSliderStyle}" />

    <!-- ============================ ScrollBar ============================ -->

    <!-- 幅は既定(17)のまま。一覧のヘッダーが 17px の余白を前提に罫線を合わせているため、
         細く見せるのはつまみ側の余白で行う -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Margin="5,2"
                            Background="{StaticResource Ctl.Thumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Ctl.ThumbHover}" />
                            <Setter TargetName="Bar" Property="Margin" Value="4,2" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Ctl.ThumbHover}" />
                            <Setter TargetName="Bar" Property="Margin" Value="4,2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumbHorizontalStyle" TargetType="Thumb"
           BasedOn="{StaticResource ScrollBarThumbStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Margin="2,5"
                            Background="{StaticResource Ctl.Thumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Ctl.ThumbHover}" />
                            <Setter TargetName="Bar" Property="Margin" Value="2,4" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Ctl.ThumbHover}" />
                            <Setter TargetName="Bar" Property="Margin" Value="2,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 余白クリックでのページ送り用。見た目は持たない -->
    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlatScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarHeightKey}}" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                      Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbHorizontalStyle}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}"
                                                      Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource FlatScrollBarStyle}" />

</ResourceDictionary>
