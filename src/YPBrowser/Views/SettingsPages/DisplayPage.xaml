<UserControl
    x:Class="YPBrowser.Views.SettingsPages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="表示設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="フォント" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,4,0"
                         Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox Grid.Column="1"
                         Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Text="チャンネル名色（お気に入り）" Margin="0,0,0,2" />
            <TextBox Margin="0,0,0,12"
                     Text="{Binding FavoriteNameColor, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="新着チャンネル色" Margin="0,0,0,2" />
            <TextBox Text="{Binding NewChannelColor, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
