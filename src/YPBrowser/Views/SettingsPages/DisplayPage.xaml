<Page
    x:Class="YPBrowser.Views.SettingsPages.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="4">
            <TextBlock Text="表示設定" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="フォント" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FontFamilyBox" Grid.Column="0"
                             PlaceholderText="Yu Gothic UI"
                             TextChanged="FontFamilyBox_TextChanged"/>
                    <NumberBox x:Name="FontSizeBox" Grid.Column="1"
                               Minimum="8" Maximum="24" SmallChange="1"
                               ValueChanged="FontSizeBox_ValueChanged"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="チャンネル名色（お気に入り）" />
                <TextBox x:Name="FavColorBox" PlaceholderText="#0000CC"
                         TextChanged="FavColorBox_TextChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="新着チャンネル色" />
                <TextBox x:Name="NewColorBox" PlaceholderText="#006600"
                         TextChanged="NewColorBox_TextChanged"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
