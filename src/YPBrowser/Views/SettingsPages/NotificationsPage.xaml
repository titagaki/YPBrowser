<UserControl
    x:Class="YPBrowser.Views.SettingsPages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="通知設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <CheckBox x:Name="EnabledCheck" Content="トースト通知を有効にする"
                      Margin="0,0,0,12" Click="EnabledCheck_Click"/>

            <TextBlock Text="バルーン表示時間（秒）" Margin="0,0,0,2" />
            <TextBox x:Name="TimeoutBox" TextChanged="TimeoutBox_TextChanged"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
