<Page
    x:Class="YPBrowser.Views.SettingsPages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="4">
            <TextBlock Text="通知設定" Style="{StaticResource SubtitleTextBlockStyle}" />

            <ToggleSwitch x:Name="EnabledSwitch" Header="トースト通知を有効にする"
                          Toggled="EnabledSwitch_Toggled"/>

            <StackPanel Spacing="4">
                <TextBlock Text="バルーン表示時間（秒）" />
                <NumberBox x:Name="TimeoutBox" Minimum="2" Maximum="30" SmallChange="1"
                           ValueChanged="TimeoutBox_ValueChanged"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
