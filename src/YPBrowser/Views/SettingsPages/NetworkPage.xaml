<UserControl
    x:Class="YPBrowser.Views.SettingsPages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="ネットワーク設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="プロキシURL (省略可)" Margin="0,0,0,2" />
            <TextBox x:Name="ProxyBox" Margin="0,0,0,12" TextChanged="ProxyBox_TextChanged"/>

            <TextBlock Text="ユーザーエージェント" Margin="0,0,0,2" />
            <TextBox x:Name="UserAgentBox" Margin="0,0,0,12" TextChanged="UserAgentBox_TextChanged"/>

            <TextBlock Text="タイムアウト（秒）" Margin="0,0,0,2" />
            <TextBox x:Name="TimeoutBox" TextChanged="TimeoutBox_TextChanged"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
