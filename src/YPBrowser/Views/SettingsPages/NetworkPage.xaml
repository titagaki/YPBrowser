<Page
    x:Class="YPBrowser.Views.SettingsPages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" Padding="4">
            <TextBlock Text="ネットワーク設定" Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBlock Text="プロキシURL (省略可)" />
                <TextBox x:Name="ProxyBox" PlaceholderText="http://proxy:8080" TextChanged="ProxyBox_TextChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="ユーザーエージェント" />
                <TextBox x:Name="UserAgentBox" TextChanged="UserAgentBox_TextChanged"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="タイムアウト（秒）" />
                <NumberBox x:Name="TimeoutBox" Minimum="3" Maximum="60" SmallChange="1"
                           ValueChanged="TimeoutBox_ValueChanged"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
