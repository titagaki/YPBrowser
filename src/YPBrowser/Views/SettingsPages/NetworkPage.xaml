<UserControl
    x:Class="YPBrowser.Views.SettingsPages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="ネットワーク設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="プロキシURL (省略可)" Margin="0,0,0,2" />
            <TextBox Margin="0,0,0,12"
                     Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="ユーザーエージェント" Margin="0,0,0,2" />
            <TextBox Margin="0,0,0,12"
                     Text="{Binding UserAgent, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="タイムアウト（秒）" Margin="0,0,0,2" />
            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
