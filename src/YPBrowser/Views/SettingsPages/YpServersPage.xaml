<UserControl
    x:Class="YPBrowser.Views.SettingsPages.YpServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:YPBrowser.Views.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Style="{StaticResource SettingPageTitleStyle}" Text="Yellow Pages" />

            <Border Style="{StaticResource SettingGroupStyle}">
                <StackPanel>
                    <ctl:SettingCard Variant="GroupHeader" Icon="&#xE774;" Title="YP サーバー"
                                     Description="チェックを外した YP は取りに行きません">
                        <Button Content="＋ 追加" Click="AddServer_Click" />
                    </ctl:SettingCard>

                    <ItemsControl ItemsSource="{Binding YpServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ctl:SettingCard Variant="SubRow"
                                                 Title="{Binding Name}"
                                                 Description="{Binding Url}"
                                                 IsDescriptionMonospace="True"
                                                 Status="{Binding StatusDisplay}"
                                                 IsStatusError="{Binding HasError}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  ToolTip="この YP を取得する" />
                                        <Button Content="⋯" Style="{StaticResource CardMenuButtonStyle}"
                                                Click="ServerMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="編集" Click="EditServer_Click" />
                                                    <Separator />
                                                    <MenuItem Header="上へ" Click="MoveServerUp_Click" />
                                                    <MenuItem Header="下へ" Click="MoveServerDown_Click" />
                                                    <Separator />
                                                    <MenuItem Header="削除" Click="RemoveServer_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </ctl:SettingCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SettingHintStyle}"
                       Text="上から順に、1 つずつ取得します。並べ替えると取得する順番が変わります。" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
