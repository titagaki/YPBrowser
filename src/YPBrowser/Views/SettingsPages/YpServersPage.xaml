<UserControl
    x:Class="YPBrowser.Views.SettingsPages.YpServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:YPBrowser.Settings">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="180" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Yellow Pages サーバー" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

        <ListBox Grid.Row="1"
                 x:Name="ServerList"
                 ItemsSource="{Binding YpServers}"
                 SelectedItem="{Binding SelectedYpServer, Mode=TwoWay}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,3">
                        <CheckBox DockPanel.Dock="Left"
                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Url}" Opacity="0.6" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Toolbar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,4">
            <Button Content="追加" Command="{Binding AddYpServerCommand}" Margin="0,0,4,0" />
            <Button Content="削除" Command="{Binding RemoveYpServerCommand}" Margin="0,0,4,0" />
            <Button Content="↑" Command="{Binding MoveYpServerUpCommand}" Margin="0,0,4,0" />
            <Button Content="↓" Command="{Binding MoveYpServerDownCommand}" />
        </StackPanel>

        <!-- Edit form -->
        <ScrollViewer Grid.Row="3">
            <StackPanel x:Name="EditPanel">
                <TextBlock Text="編集" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名前" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="YpNameBox"
                             TextChanged="YpNameBox_TextChanged" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="URL" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="YpUrlBox"
                             TextChanged="YpUrlBox_TextChanged" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ホスト" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="YpHostBox"
                             TextChanged="YpHostBox_TextChanged"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
