<Page
    x:Class="YPBrowser.Views.SettingsPages.PlayersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:YPBrowser.Settings">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="外部プレイヤー" Style="{StaticResource SubtitleTextBlockStyle}" />

        <ListView Grid.Row="1" x:Name="PlayerListView"
                  ItemsSource="{x:Bind ViewModel.Players}"
                  SelectedItem="{x:Bind ViewModel.SelectedPlayer, Mode=TwoWay}"
                  BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  SelectionChanged="PlayerList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="settings:PlayerSettings">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ExecutablePath}" Opacity="0.6" FontSize="11" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <Button Content="追加" Command="{x:Bind ViewModel.AddPlayerCommand}" />
            <Button Content="削除" Command="{x:Bind ViewModel.RemovePlayerCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="8">
                <TextBlock Text="編集" FontWeight="SemiBold" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名前" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PlayerNameBox"
                             PlaceholderText="VLC, MPC-HC, ..."
                             TextChanged="PlayerNameBox_TextChanged"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="実行ファイル" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="PlayerExeBox"
                             PlaceholderText="C:\Program Files\VLC\vlc.exe"
                             TextChanged="PlayerExeBox_TextChanged"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="参照" Click="BrowseExe_Click" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="引数" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PlayerArgsBox"
                             PlaceholderText='"{url}"'
                             TextChanged="PlayerArgsBox_TextChanged"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="デフォルト" VerticalAlignment="Center"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" x:Name="PlayerDefaultCheck"
                              Content="このプレイヤーをデフォルトにする"
                              Click="PlayerDefaultCheck_Click"/>
                </Grid>
                <TextBlock Text="{}{url} に配信URLが代入されます。" FontSize="11" Opacity="0.6" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
