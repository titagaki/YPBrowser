<UserControl
    x:Class="YPBrowser.Views.SettingsPages.BehaviorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="動作設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="自動更新間隔（秒）" Margin="0,0,0,2" />
            <TextBox Margin="0,0,0,12"
                     Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox Content="最小化でトレイに格納" Margin="0,0,0,8"
                      IsChecked="{Binding MinimizeToTray}" />

            <CheckBox Content="起動時に最小化" Margin="0,0,0,8"
                      IsChecked="{Binding StartMinimized}" />

            <CheckBox Content="お気に入りチャンネルを通知" Margin="0,0,0,8"
                      IsChecked="{Binding NotifyOnFavorite}" />

            <CheckBox Content="ダブルクリックで再生"
                      IsChecked="{Binding OpenOnDoubleClick}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
