<UserControl
    x:Class="YPBrowser.Views.SettingsPages.BehaviorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Margin="4">
            <TextBlock Text="動作設定" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

            <TextBlock Text="自動更新間隔（秒）" Margin="0,0,0,2" />
            <TextBox x:Name="IntervalBox" Margin="0,0,0,12" TextChanged="IntervalBox_TextChanged"/>

            <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化でトレイに格納"
                      Margin="0,0,0,8" Click="MinimizeToTray_Click"/>

            <CheckBox x:Name="StartMinimizedCheck" Content="起動時に最小化"
                      Margin="0,0,0,8" Click="StartMinimized_Click"/>

            <CheckBox x:Name="NotifyFavCheck" Content="お気に入りチャンネルを通知"
                      Margin="0,0,0,8" Click="NotifyFav_Click"/>

            <CheckBox x:Name="DoubleClickCheck" Content="ダブルクリックで再生"
                      Click="DoubleClick_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
