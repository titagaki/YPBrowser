<Window
    x:Class="YPBrowser.Views.PlayerEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="プレイヤーの設定"
    Width="480" SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ResizeMode="NoResize">

    <StackPanel Margin="16">

        <TextBlock Style="{StaticResource SettingFieldLabelStyle}" Text="タイプ" />
        <ComboBox x:Name="TypeBox" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10"
                  DisplayMemberPath="Label" SelectedValuePath="Value" />

        <TextBlock Style="{StaticResource SettingFieldLabelStyle}" Text="実行ファイル" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ExeBox" Margin="0,0,6,0"
                     FontFamily="Consolas, Cascadia Mono" />
            <Button Grid.Column="1" Content="参照" Click="Browse_Click" />
        </Grid>

        <TextBlock Style="{StaticResource SettingFieldLabelStyle}" Text="引数" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="ArgsBox" Margin="0,0,6,0"
                     FontFamily="Consolas, Cascadia Mono" />
            <Button Grid.Column="1" Content="設定例 ▾" Click="Presets_Click" />
        </Grid>

        <!-- 置換の説明はここだけに置く。設定画面へ常時出すと、
             プレイヤーを触らない人にも見え続ける -->
        <Border Margin="0,8,0,0" CornerRadius="6" BorderThickness="1"
                BorderBrush="{StaticResource Set.CardBorder}"
                Background="{StaticResource Set.CardBackground}">
            <ItemsControl x:Name="PlaceholderList" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource SettingTokenRowStyle}"
                                Click="InsertPlaceholder_Click"
                                ToolTip="押すと引数に差し込みます">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Token}" FontSize="11"
                                           FontFamily="Consolas, Cascadia Mono"
                                           Foreground="{StaticResource Btn.Accent}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                           Foreground="{StaticResource Ctl.ForegroundMuted}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Click="OK_Click" Width="80" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="キャンセル" Click="Cancel_Click" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
