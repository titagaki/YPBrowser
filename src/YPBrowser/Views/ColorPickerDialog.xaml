<Window
    x:Class="YPBrowser.Views.ColorPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="色の選択"
    Width="320" SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="14">
        <!-- プリセット -->
        <TextBlock Text="パレット" Foreground="#616161" FontSize="11" Margin="0,0,0,4" />
        <ItemsControl x:Name="Swatches">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="26" Height="22" Margin="0,0,3,3" Padding="0"
                            BorderBrush="#D1D1D1" BorderThickness="1"
                            Background="{Binding Brush}"
                            ToolTip="{Binding Hex}"
                            Tag="{Binding Hex}"
                            Click="Swatch_Click" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- RGB -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="Channel_Changed" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=RedSlider, StringFormat=F0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="Channel_Changed" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GreenSlider, StringFormat=F0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="Channel_Changed" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlueSlider, StringFormat=F0}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- プレビュー + 16進 -->
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="Preview" Height="30" Margin="0,0,8,0"
                    BorderThickness="1" BorderBrush="#D1D1D1" />
            <TextBox Grid.Column="1" x:Name="HexBox" VerticalAlignment="Center"
                     FontFamily="Consolas, Cascadia Mono"
                     TextChanged="HexBox_TextChanged" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Click="OK_Click" Width="76" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="キャンセル" Width="76" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
