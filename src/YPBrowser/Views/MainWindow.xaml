<Window
    x:Class="YPBrowser.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:YPBrowser.Converters"
    xmlns:controls="clr-namespace:YPBrowser.Views.Controls"
    Title="YPBrowser"
    Width="900" Height="600">

    <Grid>
        <Grid.Resources>
            <conv:NullableColorToBrushConverter x:Key="ColorToBrush" />
            <conv:ChannelDiffToColorConverter x:Key="DiffToColor" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:IntToStringConverter x:Key="IntToStr" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="更新" Command="{Binding RefreshCommand}" Padding="8,3" />
            <Button Content="お気に入り" Click="OpenFavorites_Click" Padding="8,3" />
            <Separator />
            <Button Content="設定" Click="OpenSettings_Click" Padding="8,3" />
            <Separator />
            <ProgressBar IsIndeterminate="True" Width="80" Height="8"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
        </ToolBar>

        <!-- Search + Filter row -->
        <Grid Grid.Row="1" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,6,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FilterLabels}"
                      SelectedIndex="{Binding ActiveFilterIndex, Mode=TwoWay}"
                      MinWidth="120" />
        </Grid>

        <!-- Channel list + detail panel -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="DetailRow" Height="150" MinHeight="80" MaxHeight="300" />
            </Grid.RowDefinitions>

            <!-- Channel list -->
            <DockPanel Grid.Row="0">
                <!-- Column header (left pad=6 matches ListBoxItem padding below) -->
                <Border DockPanel.Dock="Top" Padding="6,3,6,3"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="17" /><!-- scrollbar gutter -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="チャンネル名" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="ジャンル" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Kbps" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="視聴" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="リレー" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="コーデック" FontWeight="SemiBold" FontSize="12" />
                    </Grid>
                </Border>

                <ListBox x:Name="ChannelListView"
                         ItemsSource="{Binding FilteredChannels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         SelectionChanged="ChannelList_SelectionChanged"
                         MouseDoubleClick="ChannelList_MouseDoubleClick"
                         KeyDown="ChannelList_KeyDown"
                         BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding ChannelName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ChannelName}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Genre}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#555555" FontSize="12" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding BitrateDisplay}"
                                           HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ListenersDisplay}"
                                           HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock Grid.Column="4"
                                           Text="{Binding RelaysDisplay}"
                                           HorizontalAlignment="Right" FontSize="12" />
                                <TextBlock Grid.Column="5"
                                           Text="{Binding ChannelType}"
                                           Foreground="#555555" FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="再生" Click="PlayChannel_Click" />
                            <Separator />
                            <MenuItem Header="URLをコピー" Click="CopyUrl_Click" />
                            <MenuItem x:Name="OpenContactMenuItem" Header="連絡先を開く" Click="OpenContact_Click" />
                            <Separator />
                            <MenuItem Header="更新" Click="Refresh_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <!-- GridSplitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext" />

            <!-- Channel detail panel -->
            <controls:ChannelDetailPanel Grid.Row="2" x:Name="DetailPanel"
                                         BorderThickness="0,1,0,0"
                                         BorderBrush="#CCCCCC" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="8,3"
                BorderThickness="0,1,0,0" BorderBrush="#CCCCCC"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding NextRefreshText}"
                           VerticalAlignment="Center" FontSize="12" Foreground="#888888" />
            </Grid>
        </Border>
    </Grid>
</Window>
