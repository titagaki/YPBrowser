<Window
    x:Class="YPBrowser.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:YPBrowser.Converters"
    xmlns:controls="clr-namespace:YPBrowser.Views.Controls"
    Title="YPBrowser"
    Width="980" Height="600">

    <Grid>
        <Grid.Resources>
            <conv:NullableColorToBrushConverter x:Key="ColorToBrush" />
            <conv:ChannelDiffToColorConverter x:Key="DiffToColor" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:IntToStringConverter x:Key="IntToStr" />

            <!-- タグのチップ。色が無いタグはグレーで出す -->
            <DataTemplate x:Key="TagChipTemplate">
                <Border Margin="0,0,3,0" Padding="5,0" CornerRadius="3"
                        Background="{Binding BackColorValue, Converter={StaticResource ColorToBrush}, ConverterParameter=#F0F0F0}">
                    <TextBlock Text="{Binding Name}" FontSize="10"
                               Foreground="{Binding ForeColorValue, Converter={StaticResource ColorToBrush}, ConverterParameter=#616161}" />
                </Border>
            </DataTemplate>
            <!-- 縦の点線セパレータ用ブラシ (1px幅のRectangleのFillに使用) -->
            <DrawingBrush x:Key="DashedVSepBrush" TileMode="Tile"
                          Viewport="0,0,1,6" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#BBBBBB">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <!-- 横の点線セパレータ用ブラシ (1px高のRectangleのFillに使用) -->
            <DrawingBrush x:Key="DashedHSepBrush" TileMode="Tile"
                          Viewport="0,0,6,1" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,3,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="更新" Command="{Binding RefreshCommand}" Padding="8,3" />
            <Button Content="ルール" Click="OpenRules_Click" Padding="8,3" />
            <Button Content="タグ" Click="OpenTags_Click" Padding="8,3" />
            <Separator />
            <Button Content="設定" Click="OpenSettings_Click" Padding="8,3" />
            <Separator />
            <ProgressBar IsIndeterminate="True" Width="80" Height="8"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
        </ToolBar>

        <!-- 絞り込み欄。単純な部分一致で、保存しない一時的なフィルタ -->
        <Grid Grid.Row="1" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="絞り込み（部分一致）"
                     Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding ResultCountText}"
                       VerticalAlignment="Center" FontSize="11" Foreground="#8A8A8A" />
        </Grid>

        <!-- Tab: チャンネル一覧 / 録画中 -->
        <TabControl Grid.Row="2" x:Name="MainTabControl" BorderThickness="0">
            <!-- チャンネル一覧タブ -->
            <TabItem Header="チャンネル一覧">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition x:Name="DetailRow" Height="150" MinHeight="80" MaxHeight="300" />
                    </Grid.RowDefinitions>

                    <!-- ビュー欄: 組み込みビューの下にタグが自動で並ぶ -->
                    <Border Grid.Column="0" Grid.RowSpan="3"
                            BorderThickness="0,0,1,0" BorderBrush="#E5E5E5"
                            Background="#FAFAFA">
                        <ListBox ItemsSource="{Binding Views}"
                                 SelectedItem="{Binding SelectedView, Mode=TwoWay}"
                                 BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#8A8A8A"
                                                       Margin="6,7,0,2" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- タグの色が付いていれば小さく見せる -->
                                        <Border Grid.Column="0" Width="8" Height="8" CornerRadius="2"
                                                Margin="0,0,5,0" VerticalAlignment="Center"
                                                Background="{Binding Tag.BackColorValue, Converter={StaticResource ColorToBrush}}"
                                                Visibility="{Binding Tag.HasColor, Converter={StaticResource BoolToVis},
                                                             FallbackValue=Collapsed}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                                   FontSize="11" Foreground="#8A8A8A" Margin="4,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- Channel list -->
                    <DockPanel Grid.Row="0" Grid.Column="1">
                        <!-- Column header -->
                        <Border DockPanel.Dock="Top" Padding="6,3,6,3"
                                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" /><!-- 星 -->
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="65" />
                                    <ColumnDefinition Width="17" /><!-- scrollbar gutter -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="チャンネル名" FontWeight="SemiBold" FontSize="12" />
                                <Rectangle Grid.Column="2" Fill="{StaticResource DashedVSepBrush}" />
                                <TextBlock Grid.Column="3" Text="タグ" FontWeight="SemiBold" FontSize="12"
                                           Margin="4,0,0,0"/>
                                <Rectangle Grid.Column="4" Fill="{StaticResource DashedVSepBrush}" />
                                <TextBlock Grid.Column="5" Text="視聴/リレー" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Right" Margin="4,0"/>
                                <Rectangle Grid.Column="6" Fill="{StaticResource DashedVSepBrush}" />
                                <TextBlock Grid.Column="7" Text="ビットレート" FontWeight="SemiBold" FontSize="12"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- 非表示件数バー。0 件でも出し続ける:
                             フィルタで消えた配信と YP に出ていない配信を区別できなくなるため -->
                        <Border DockPanel.Dock="Bottom" Padding="6,3"
                                BorderThickness="0,1,0,0" BorderBrush="#E5E5E5"
                                Background="#FAFAFA">
                            <Grid>
                                <TextBlock Text="{Binding HiddenNoticeText}" FontSize="11"
                                           Foreground="#616161" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" Padding="8,1" FontSize="11"
                                        Command="{Binding ToggleShowHiddenCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Content" Value="表示する" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowHidden}" Value="True">
                                                    <Setter Property="Content" Value="隠す" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox x:Name="ChannelListView"
                                 ItemsSource="{Binding FilteredChannels}"
                                 SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                 SelectionChanged="ChannelList_SelectionChanged"
                                 MouseDoubleClick="ChannelList_MouseDoubleClick"
                                 KeyDown="ChannelList_KeyDown"
                                 BorderThickness="0"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,0" />
                                    <!-- 色は「そのチャンネルが持つタグのうち、色が設定されている最初のもの」 -->
                                    <Setter Property="Background" Value="{Binding TagBackColor, Converter={StaticResource ColorToBrush}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Diff}" Value="Log">
                                            <Setter Property="Background" Value="#EFEFEF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="1" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 星。クリックでお気に入りタグの付け外し -->
                                        <Button Grid.Row="0" Grid.Column="0"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="0" Cursor="Hand"
                                                VerticalAlignment="Center"
                                                ToolTip="お気に入り"
                                                Command="{Binding DataContext.ToggleStarCommand,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="☆" />
                                                        <Setter Property="Foreground" Value="#C8C8C8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Text" Value="★" />
                                                                <Setter Property="Foreground" Value="#B8860B" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Channel name + genre/description (2 lines) -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,3,4,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ChannelName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ChannelName}"
                                                           Foreground="{Binding Diff, Converter={StaticResource DiffToColor}}"
                                                           FontSize="12" />
                                                <!-- 新着バッジ -->
                                                <TextBlock Text="新" FontSize="10" Foreground="#0067C0"
                                                           Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding GenreDescription}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#777777" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GenreDescription}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- 縦の点線セパレータ -->
                                        <Rectangle Grid.Row="0" Grid.Column="2" Fill="{StaticResource DashedVSepBrush}" />
                                        <!-- タグのチップ -->
                                        <ItemsControl Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Tags}"
                                                      VerticalAlignment="Center" Margin="4,3"
                                                      ItemTemplate="{StaticResource TagChipTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <Rectangle Grid.Row="0" Grid.Column="4" Fill="{StaticResource DashedVSepBrush}" />
                                        <!-- Listeners/Relays + Uptime (2 lines) -->
                                        <StackPanel Grid.Row="0" Grid.Column="5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="4,3">
                                            <TextBlock Text="{Binding ListenersRelaysDisplay}"
                                                       HorizontalAlignment="Right" FontSize="12" />
                                            <TextBlock Text="{Binding BroadcastTimeStr}"
                                                       HorizontalAlignment="Right" FontSize="11" Foreground="#888888" />
                                        </StackPanel>
                                        <Rectangle Grid.Row="0" Grid.Column="6" Fill="{StaticResource DashedVSepBrush}" />
                                        <!-- Bitrate / Codec (2 lines) -->
                                        <StackPanel Grid.Row="0" Grid.Column="7"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="6,3,0,3">
                                            <TextBlock Text="{Binding BitrateDisplay}"
                                                       HorizontalAlignment="Right" FontSize="12" />
                                            <TextBlock Text="{Binding ChannelType}"
                                                       HorizontalAlignment="Right" FontSize="11" Foreground="#555555" />
                                        </StackPanel>
                                        <!-- 横の点線セパレータ (行の下端) -->
                                        <Rectangle Grid.Row="1" Grid.ColumnSpan="8"
                                                   Fill="{StaticResource DashedHSepBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="再生" Click="PlayChannel_Click" />
                                    <Separator />
                                    <MenuItem Header="コンタクトURLを開く" Click="OpenContact_Click" />
                                    <MenuItem Header="統計URLを開く" Click="OpenStats_Click" />
                                    <Separator />
                                    <MenuItem Header="お気に入り（切替）" Click="ToggleStar_Click" />
                                    <MenuItem Header="この条件でルールを作成..." Click="CreateRuleFromChannel_Click" />
                                    <Separator />
                                    <MenuItem Header="コピー（チャンネル情報）" Click="CopyChannelDetail_Click" />
                                    <MenuItem Header="コピー（プレイリストURL）" Click="CopyUrl_Click" />
                                    <Separator />
                                    <MenuItem Header="録音/録画" Click="StartRecord_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <!-- GridSplitter -->
                    <GridSplitter Grid.Row="1" Grid.Column="1" Height="5" HorizontalAlignment="Stretch"
                                  Background="#DDDDDD" ResizeBehavior="PreviousAndNext" />

                    <!-- Channel detail panel -->
                    <controls:ChannelDetailPanel Grid.Row="2" Grid.Column="1" x:Name="DetailPanel"
                                                 BorderThickness="0,1,0,0"
                                                 BorderBrush="#CCCCCC" />
                </Grid>
            </TabItem>

            <!-- 録画中タブ -->
            <TabItem Header="{Binding RecordingEntries.Count, StringFormat=録画中 ({0})}">
                <DockPanel>
                    <!-- Column header: BorderPadding の横幅 = ListBoxItem の Padding 横幅 にすることで
                         gutter=17(スクロールバー幅)だけで罫線位置が揃う -->
                    <Border DockPanel.Dock="Top" Padding="2,3,2,3"
                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                            BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" /><!-- 停止ボタン -->
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="17" /><!-- scrollbar gutter = ScrollBarWidth(17) + ItemPad(4) - BorderPad(4) -->
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="1" Fill="{StaticResource DashedVSepBrush}" />
                            <TextBlock Grid.Column="2" Text="チャンネル名" FontWeight="SemiBold" FontSize="12" />
                            <Rectangle Grid.Column="3" Fill="{StaticResource DashedVSepBrush}" />
                            <TextBlock Grid.Column="4" Text="チャンネル詳細" FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0"/>
                            <Rectangle Grid.Column="5" Fill="{StaticResource DashedVSepBrush}" />
                            <TextBlock Grid.Column="6" Text="ダウンロードステータス" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"/>
                            <Rectangle Grid.Column="7" Fill="{StaticResource DashedVSepBrush}" />
                            <TextBlock Grid.Column="8" Text="リトライ" FontWeight="SemiBold" FontSize="12"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                    </Border>

                    <ListBox ItemsSource="{Binding RecordingEntries}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,0" />
                                <Setter Property="Background" Value="White" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Background" Value="#EDE7F6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 停止ボタン（アクティブ時のみ表示） -->
                                    <Button Grid.Column="0" Content="停止"
                                            Padding="2,1" Margin="2,2"
                                            Click="StopRecord_Click"
                                            Tag="{Binding ChannelId}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <Rectangle Grid.Column="1" Fill="{StaticResource DashedVSepBrush}" />
                                    <!-- チャンネル名（終了後は「（終了）」付き・ファイルパスをツールチップ） -->
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FilePath}"
                                               FontSize="12" VerticalAlignment="Center" Margin="4,3,4,3"/>
                                    <Rectangle Grid.Column="3" Fill="{StaticResource DashedVSepBrush}" />
                                    <!-- チャンネル詳細 -->
                                    <TextBlock Grid.Column="4" Text="{Binding ChannelDetail}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ChannelDetail}"
                                               FontSize="11" Foreground="#555555"
                                               VerticalAlignment="Center" Margin="6,3,4,3"/>
                                    <Rectangle Grid.Column="5" Fill="{StaticResource DashedVSepBrush}" />
                                    <!-- ダウンロードステータス（右寄せ） -->
                                    <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="4,3,4,3"/>
                                    <Rectangle Grid.Column="7" Fill="{StaticResource DashedVSepBrush}" />
                                    <!-- リトライ回数（0 は空欄・右寄せ） -->
                                    <TextBlock Grid.Column="8" Text="{Binding RetryCountDisplay}"
                                               FontSize="12" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Margin="4,3,4,3"/>
                                    <Rectangle Grid.Row="1" Grid.ColumnSpan="9"
                                               Fill="{StaticResource DashedHSepBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="8,3"
                BorderThickness="0,1,0,0" BorderBrush="#CCCCCC"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding NextRefreshText}"
                           VerticalAlignment="Center" FontSize="12" Foreground="#888888" />
            </Grid>
        </Border>
    </Grid>
</Window>
