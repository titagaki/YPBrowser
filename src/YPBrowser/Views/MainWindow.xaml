<Window
    x:Class="YPBrowser.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:YPBrowser.Converters"
    xmlns:models="using:YPBrowser.Models"
    xmlns:controls="using:YPBrowser.Views.Controls"
    Title="YPBrowser">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <conv:NullableColorToBrushConverter x:Key="ColorToBrush" />
            <conv:ChannelDiffToColorConverter x:Key="DiffToColor" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:IntToStringConverter x:Key="IntToStr" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Toolbar -->
            <RowDefinition Height="Auto" />  <!-- Search + Filter -->
            <RowDefinition Height="*" />     <!-- List + Detail -->
            <RowDefinition Height="Auto" />  <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Refresh" Label="更新" Command="{x:Bind ViewModel.RefreshCommand}"
                          IsEnabled="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
            <AppBarButton Icon="Favorite" Label="お気に入り" Click="OpenFavorites_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="設定" Click="OpenSettings_Click" />

            <CommandBar.Content>
                <ProgressRing x:Name="RefreshRing"
                              IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                              Width="20" Height="20" Margin="8,0" />
            </CommandBar.Content>
        </CommandBar>

        <!-- Search + Filter row -->
        <Grid Grid.Row="1" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="チャンネルを検索..."
                     Margin="0,0,8,0" />

            <ComboBox Grid.Column="1"
                      ItemsSource="{x:Bind ViewModel.FilterLabels}"
                      SelectedIndex="{x:Bind ViewModel.ActiveFilterIndex, Mode=TwoWay}"
                      MinWidth="120" />
        </Grid>

        <!-- Channel list + detail panel -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="150" MinHeight="80" MaxHeight="300" />
            </Grid.RowDefinitions>

            <!-- Channel list -->
            <ListView Grid.Row="0"
                      x:Name="ChannelListView"
                      ItemsSource="{x:Bind ViewModel.FilteredChannels, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedChannel, Mode=TwoWay}"
                      SelectionChanged="ChannelList_SelectionChanged"
                      DoubleTapped="ChannelList_DoubleTapped"
                      KeyDown="ChannelList_KeyDown"
                      VirtualizingStackPanel.VirtualizationMode="Recycling">

                <ListView.Header>
                    <Grid Margin="12,4" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="チャンネル名" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="ジャンル" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="Kbps" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="視聴" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="リレー" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="コーデック" FontWeight="SemiBold" FontSize="12" />
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChannelItem">
                        <Grid ColumnSpacing="4" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ChannelName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ChannelName}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Genre}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" Opacity="0.8" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind BitrateDisplay}"
                                       HorizontalAlignment="Right" FontSize="12" />
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind ListenersDisplay}"
                                       HorizontalAlignment="Right" FontSize="12" />
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind RelaysDisplay}"
                                       HorizontalAlignment="Right" FontSize="12" />
                            <TextBlock Grid.Column="5"
                                       Text="{x:Bind ChannelType}"
                                       FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="再生" Click="PlayChannel_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Play" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="URLをコピー" Click="CopyUrl_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Copy" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="OpenContactMenuItem" Text="連絡先を開く" Click="OpenContact_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="更新" Click="Refresh_Click">
                            <MenuFlyoutItem.Icon>
                                <SymbolIcon Symbol="Refresh" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <!-- Splitter -->
            <Border Grid.Row="1" Height="4" Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    ManipulationMode="TranslateY"
                    ManipulationDelta="Splitter_ManipulationDelta" />

            <!-- Channel detail panel -->
            <controls:ChannelDetailPanel Grid.Row="2" x:Name="DetailPanel"
                                         BorderThickness="0,1,0,0"
                                         BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Padding="12,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                       VerticalAlignment="Center" FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.NextRefreshText, Mode=OneWay}"
                       VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
        </Grid>
    </Grid>
</Window>
