<Window
    x:Class="YPBrowser.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:YPBrowser.Converters"
    xmlns:controls="clr-namespace:YPBrowser.Views.Controls"
    Title="YPBrowser"
    Width="900" Height="600">

    <Grid>
        <Grid.Resources>
            <conv:NullableColorToBrushConverter x:Key="ColorToBrush" />
            <conv:ChannelDiffToColorConverter x:Key="DiffToColor" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:IntToStringConverter x:Key="IntToStr" />
            <!-- 縦の点線セパレータ用ブラシ (1px幅のRectangleのFillに使用) -->
            <DrawingBrush x:Key="DashedVSepBrush" TileMode="Tile"
                          Viewport="0,0,1,6" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#BBBBBB">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <!-- 横の点線セパレータ用ブラシ (1px高のRectangleのFillに使用) -->
            <DrawingBrush x:Key="DashedHSepBrush" TileMode="Tile"
                          Viewport="0,0,6,1" ViewportUnits="Absolute" Stretch="None">
                <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,3,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0">
            <Button Content="更新" Command="{Binding RefreshCommand}" Padding="8,3" />
            <Button Content="お気に入り" Click="OpenFavorites_Click" Padding="8,3" />
            <Separator />
            <Button Content="設定" Click="OpenSettings_Click" Padding="8,3" />
            <Separator />
            <ProgressBar IsIndeterminate="True" Width="80" Height="8"
                         Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
        </ToolBar>

        <!-- Search + Filter row -->
        <Grid Grid.Row="1" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,6,0" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding FilterLabels}"
                      SelectedIndex="{Binding ActiveFilterIndex, Mode=TwoWay}"
                      MinWidth="120" />
        </Grid>

        <!-- Channel list + detail panel -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition x:Name="DetailRow" Height="150" MinHeight="80" MaxHeight="300" />
            </Grid.RowDefinitions>

            <!-- Channel list -->
            <DockPanel Grid.Row="0">
                <!-- Column header -->
                <Border DockPanel.Dock="Top" Padding="6,3,6,3"
                        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                        BorderThickness="0,0,0,1" BorderBrush="#CCCCCC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="75" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="17" /><!-- scrollbar gutter -->
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="チャンネル名" FontWeight="SemiBold" FontSize="12" />
                        <Rectangle Grid.Column="1" Fill="{StaticResource DashedVSepBrush}" />
                        <TextBlock Grid.Column="2" Text="視聴/リレー" FontWeight="SemiBold" FontSize="12"
                                   HorizontalAlignment="Right" Margin="4,0"/>
                        <Rectangle Grid.Column="3" Fill="{StaticResource DashedVSepBrush}" />
                        <TextBlock Grid.Column="4" Text="ビットレート" FontWeight="SemiBold" FontSize="12"
                                   Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ChannelListView"
                         ItemsSource="{Binding FilteredChannels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         SelectionChanged="ChannelList_SelectionChanged"
                         MouseDoubleClick="ChannelList_MouseDoubleClick"
                         KeyDown="ChannelList_KeyDown"
                         BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Background" Value="{Binding FavBackColor, Converter={StaticResource ColorToBrush}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Diff}" Value="Log">
                                    <Setter Property="Background" Value="#EFEFEF" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="1" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="75" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>
                                <!-- Channel name + genre/description (2 lines) -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,3,4,3">
                                    <TextBlock Text="{Binding ChannelName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ChannelName}"
                                               Foreground="{Binding Diff, Converter={StaticResource DiffToColor}}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding GenreDescription}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="#777777" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GenreDescription}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- 縦の点線セパレータ -->
                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{StaticResource DashedVSepBrush}" />
                                <Rectangle Grid.Row="0" Grid.Column="3" Fill="{StaticResource DashedVSepBrush}" />
                                <!-- Listeners/Relays + Uptime (2 lines) -->
                                <StackPanel Grid.Row="0" Grid.Column="2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="4,3">
                                    <TextBlock Text="{Binding ListenersRelaysDisplay}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Text="{Binding BroadcastTimeStr}"
                                               HorizontalAlignment="Right" FontSize="11" Foreground="#888888" />
                                </StackPanel>
                                <!-- Bitrate / Codec (2 lines) -->
                                <StackPanel Grid.Row="0" Grid.Column="4"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="6,3,0,3">
                                    <TextBlock Text="{Binding BitrateDisplay}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Text="{Binding ChannelType}"
                                               HorizontalAlignment="Right" FontSize="11" Foreground="#555555" />
                                </StackPanel>
                                <!-- 横の点線セパレータ (行の下端) -->
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5"
                                           Fill="{StaticResource DashedHSepBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="再生" Click="PlayChannel_Click" />
                            <Separator />
                            <MenuItem Header="コンタクトURLを開く" Click="OpenContact_Click" />
                            <MenuItem Header="統計URLを開く" Click="OpenStats_Click" />
                            <Separator />
                            <MenuItem Header="お気に入りに追加" Click="AddFavorite_Click" />
                            <MenuItem Header="お気に入りから削除" Click="RemoveFavorite_Click" />
                            <MenuItem Header="コピー（チャンネル情報）" Click="CopyChannelDetail_Click" />
                            <MenuItem Header="コピー（プレイリストURL）" Click="CopyUrl_Click" />
                            <Separator />
                            <MenuItem Header="録音/録画" Click="StartRecord_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <!-- GridSplitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext" />

            <!-- Channel detail panel -->
            <controls:ChannelDetailPanel Grid.Row="2" x:Name="DetailPanel"
                                         BorderThickness="0,1,0,0"
                                         BorderBrush="#CCCCCC" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="8,3"
                BorderThickness="0,1,0,0" BorderBrush="#CCCCCC"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1"
                           Text="{Binding NextRefreshText}"
                           VerticalAlignment="Center" FontSize="12" Foreground="#888888" />
            </Grid>
        </Border>
    </Grid>
</Window>
