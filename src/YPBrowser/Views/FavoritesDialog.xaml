<Window
    x:Class="YPBrowser.Views.FavoritesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:YPBrowser.Settings"
    Title="お気に入り">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: List + toolbar -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                          ItemsSource="{x:Bind ViewModel.Favorites}"
                          SelectedItem="{x:Bind ViewModel.SelectedFavorite, Mode=TwoWay}"
                          BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="settings:FavoriteSettings">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Text="{x:Bind Word}" FontSize="11" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
                    <Button Content="追加" Command="{x:Bind ViewModel.AddFavoriteCommand}" />
                    <Button Content="削除" Command="{x:Bind ViewModel.RemoveFavoriteCommand}" />
                    <Button Content="↑" Command="{x:Bind ViewModel.MoveFavoriteUpCommand}" />
                    <Button Content="↓" Command="{x:Bind ViewModel.MoveFavoriteDownCommand}" />
                </StackPanel>
            </Grid>

            <!-- Right: Edit form -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12" x:Name="EditPanel">
                    <TextBlock Text="編集" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="タイトル" />
                        <TextBox x:Name="TitleBox"
                                 Text="{x:Bind ViewModel.SelectedFavorite.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="お気に入りの名前" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="キーワード / 正規表現" />
                        <TextBox x:Name="WordBox"
                                 Text="{x:Bind ViewModel.SelectedFavorite.Word, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="例: ゲーム, ^Stream.*" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="対象フィールド" />
                        <Grid ColumnSpacing="4" RowSpacing="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox Grid.Row="0" Grid.Column="0" Content="チャンネル名" x:Name="TargetName" Click="Target_Click"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" Content="ジャンル" x:Name="TargetGenre" Click="Target_Click"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" Content="説明" x:Name="TargetDesc" Click="Target_Click"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" Content="コメント" x:Name="TargetComment" Click="Target_Click"/>
                            <CheckBox Grid.Row="1" Grid.Column="1" Content="連絡先URL" x:Name="TargetContact" Click="Target_Click"/>
                            <CheckBox Grid.Row="1" Grid.Column="2" Content="YP名" x:Name="TargetYp" Click="Target_Click"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" Content="コーデック" x:Name="TargetType" Click="Target_Click"/>
                            <CheckBox Grid.Row="2" Grid.Column="1" Content="曲名" x:Name="TargetTrackTitle" Click="Target_Click"/>
                            <CheckBox Grid.Row="2" Grid.Column="2" Content="アーティスト" x:Name="TargetTrackArtist" Click="Target_Click"/>
                        </Grid>
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="IsRegexCheck"
                                  IsChecked="{x:Bind ViewModel.SelectedFavorite.IsRegex, Mode=TwoWay}"
                                  Content="正規表現として使用" />
                        <CheckBox Grid.Column="1" x:Name="IsNGCheck"
                                  IsChecked="{x:Bind ViewModel.SelectedFavorite.IsNG, Mode=TwoWay}"
                                  Content="NGリスト（除外）" />
                    </Grid>

                    <CheckBox x:Name="NotifyCheck"
                              IsChecked="{x:Bind ViewModel.SelectedFavorite.NotifyEnabled, Mode=TwoWay}"
                              Content="新着時に通知する" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="背景色 (例: #FFFF99)" />
                        <TextBox x:Name="BackColorBox"
                                 Text="{x:Bind ViewModel.SelectedFavorite.BackColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="文字色 (例: #000000)" />
                        <TextBox x:Name="TextColorBox"
                                 Text="{x:Bind ViewModel.SelectedFavorite.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0" Spacing="8">
            <Button Content="OK" Style="{StaticResource AccentButtonStyle}" Click="OK_Click" />
            <Button Content="キャンセル" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
