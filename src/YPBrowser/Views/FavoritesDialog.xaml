<Window
    x:Class="YPBrowser.Views.FavoritesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="お気に入り"
    Width="680" Height="480"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: List + toolbar -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0"
                         ItemsSource="{Binding Favorites}"
                         SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Text="{Binding Word}" FontSize="11" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="追加" Command="{Binding AddFavoriteCommand}" Margin="0,0,4,0" />
                    <Button Content="削除" Command="{Binding RemoveFavoriteCommand}" Margin="0,0,4,0" />
                    <Button Content="↑" Command="{Binding MoveFavoriteUpCommand}" Margin="0,0,4,0" />
                    <Button Content="↓" Command="{Binding MoveFavoriteDownCommand}" />
                </StackPanel>
            </Grid>

            <!-- Right: Edit form -->
            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="EditPanel">
                    <TextBlock Text="編集" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <TextBlock Text="タイトル" Margin="0,0,0,2" />
                    <TextBox x:Name="TitleBox"
                             Text="{Binding SelectedFavorite.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />

                    <TextBlock Text="キーワード / 正規表現" Margin="0,0,0,2" />
                    <TextBox x:Name="WordBox"
                             Text="{Binding SelectedFavorite.Word, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />

                    <TextBlock Text="対象フィールド" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="チャンネル名" x:Name="TargetName" Click="Target_Click"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Content="ジャンル" x:Name="TargetGenre" Click="Target_Click"/>
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="説明" x:Name="TargetDesc" Click="Target_Click"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Content="コメント" x:Name="TargetComment" Click="Target_Click"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Content="連絡先URL" x:Name="TargetContact" Click="Target_Click"/>
                        <CheckBox Grid.Row="1" Grid.Column="2" Content="YP名" x:Name="TargetYp" Click="Target_Click"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Content="コーデック" x:Name="TargetType" Click="Target_Click"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="曲名" x:Name="TargetTrackTitle" Click="Target_Click"/>
                        <CheckBox Grid.Row="2" Grid.Column="2" Content="アーティスト" x:Name="TargetTrackArtist" Click="Target_Click"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" x:Name="IsRegexCheck"
                                  IsChecked="{Binding SelectedFavorite.IsRegex, Mode=TwoWay}"
                                  Content="正規表現として使用" />
                        <CheckBox Grid.Column="1" x:Name="IsNGCheck"
                                  IsChecked="{Binding SelectedFavorite.IsNG, Mode=TwoWay}"
                                  Content="NGリスト（除外）" />
                    </Grid>

                    <CheckBox x:Name="NotifyCheck"
                              IsChecked="{Binding SelectedFavorite.NotifyEnabled, Mode=TwoWay}"
                              Content="新着時に通知する"
                              Margin="0,0,0,8" />

                    <TextBlock Text="背景色 (例: #FFFF99)" Margin="0,0,0,2" />
                    <TextBox x:Name="BackColorBox"
                             Text="{Binding SelectedFavorite.BackColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />

                    <TextBlock Text="文字色 (例: #000000)" Margin="0,0,0,2" />
                    <TextBox x:Name="TextColorBox"
                             Text="{Binding SelectedFavorite.TextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="OK" Click="OK_Click" Width="80" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="キャンセル" Click="Cancel_Click" Width="80" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
